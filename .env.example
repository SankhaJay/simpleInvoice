# ---------------------------------------------------------------------------
# SimpleInvoice — environment configuration
#
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored and MUST NOT be committed.
# ---------------------------------------------------------------------------

# 101 Digital identity server (OAuth2 token endpoint host)
AUTH_BASE_URL=https://www.example.com

# 101 Digital API gateway (membership-service, invoice-service)
API_BASE_URL=https://www.example.com

# OAuth2 client credentials (SANDBOX — treat as sensitive, never hardcode)
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_SCOPE=openid

# Secret used to encrypt (AES-seal) the session cookie via iron-session.
# Must be at least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET=replace-with-a-strong-random-32char-min-secret

# Cookie name for the encrypted session (optional; defaults to `si_session`)
SESSION_COOKIE_NAME=si_session
