# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets are never committed; .env.example is the template
.env
.env.local
.env*.local
!.env.example

# The architecture docs, ADRs and Postman collection are committed (shareable).
# But the assessment brief and the Postman *environment* contain the real
# sandbox credentials (Appendix A) — keep those out of the repo.
docs/Assessment Project*
docs/postman/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# playwright
/test-results
/playwright-report
/playwright/.cache

